# Copie ce fichier en ".env" puis remplis la clé (ou saisis-la plus tard dans
# l'interface : Réglages > Clé API, compte administrateur uniquement).
# NE METS JAMAIS de vraie clé dans ce fichier d'exemple.

# --- Fournisseur IA -------------------------------------------------------
# Détecté automatiquement d'après la clé : "xai-..." => xAI (Grok), "gsk_..." => Groq.
AI_API_KEY=
# AI_PROVIDER=xai          # ou groq (force le choix)
# AI_BASE_URL=             # défaut selon le fournisseur
# AI_CHAT_MODEL=           # xAI: grok-4.7 | Groq: openai/gpt-oss-120b (défaut)
# AI_FALLBACK_MODELS=      # Groq: llama-3.3-70b-versatile,llama-3.1-8b-instant (repli si quota atteint)
# AI_VISION_MODEL=         # modèle utilisé quand une capture d'écran est envoyée
# AI_STT_MODEL=            # xAI: grok-voice-transcribe-2.0 | Groq: whisper-large-v3-turbo
# AI_STT_LANGUAGE=         # Groq: fr (défaut) ; xAI: laisser vide
# AI_TTS_MODEL=            # Groq: vide = voix du navigateur (pas de TTS français chez Groq)
# AI_TTS_VOICE=            # xAI: eve
# AI_TTS_LANGUAGE=fr

# --- Serveur --------------------------------------------------------------
PORT=8787
# 0.0.0.0 = joignable depuis le téléphone (réseau local / tunnel). 127.0.0.1 = PC seul.
HOST=0.0.0.0
# Le premier compte (admin) est toujours créable ; les suivants seulement si true.
ALLOW_SIGNUP=false
# Secret de signature des sessions (généré automatiquement dans data/ si vide)
JWT_SECRET=
