{
  // Worker JARVIS : API + Durable Object (hub/cerveau) + interface statique (dossier web/)
  "name": "jarvis",
  "account_id": "2949f0587afaf276b01c9f4f7f462149",
  "workers_dev": true,
  "main": "cloud/src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/ws", "/downloads/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "UserHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserHub"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "jarvis", "database_id": "e46ec31a-28b7-4e95-bf20-b1d5f5dae3a6" }
  ],
  // IA de secours sans clé (quota gratuit quotidien) : utilisée quand Groq & co sont en quota
  "ai": { "binding": "AI" },
  // Domaine personnalisé : le DNS jarvis.avenox.fr est créé automatiquement par le déploiement (zone avenox.fr du compte).
  "routes": [{ "pattern": "jarvis.avenox.fr", "custom_domain": true }],
  "observability": { "enabled": true }
}
